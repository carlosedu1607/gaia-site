---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ReviewBanner from "../components/ReviewBanner.astro";
import site from "../content/site.json";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = site.seo.title,
  description = site.seo.description,
  noindex = false
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const reviewMode = import.meta.env.PUBLIC_REVIEW_MODE === "true";
const fullTitle = title === site.seo.title ? title : `${title} | ${site.brand.shortName}`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: site.brand.name,
  legalName: site.brand.legalName,
  taxID: site.brand.cnpj,
  description: site.seo.description,
  url: canonical.origin,
  telephone: site.contact.phoneDisplay,
  address: {
    "@type": "PostalAddress",
    streetAddress: site.contact.addressLine,
    addressLocality: site.contact.city,
    addressRegion: site.contact.state,
    postalCode: site.contact.postalCode,
    addressCountry: "BR"
  },
  sameAs: [site.contact.instagramUrl]
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#123f33" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-16x16.png" type="image/png" sizes="16x16" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/media/site/fachada-1600.webp", canonical.origin)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/media/site/fachada-1600.webp", canonical.origin)} />
    <title>{fullTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    {reviewMode && <ReviewBanner message={site.project.notice} />}
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <a
      class="whatsapp-float"
      href={`https://wa.me/${site.contact.whatsappDigits}?text=${encodeURIComponent("Olá! Conheci a Gaia pelo site e gostaria de mais informações.")}`}
      target="_blank"
      rel="noreferrer"
      aria-label="Falar com a Gaia pelo WhatsApp"
      data-event="floating_whatsapp"
    >
      <img src="/icons/whatsapp-enviado.png" alt="" aria-hidden="true" width="58" height="58" />
    </a>

    <script is:inline>
      document.addEventListener("click", function (event) {
        var target = event.target;
        if (!target) return;
        var link = target.closest("a[href*='wa.me'], a[data-event*='whatsapp']");
        if (!link) return;

        var buttonId = link.getAttribute("data-event") || "whatsapp_link";
        var params = new URLSearchParams(window.location.search);
        var payload = {
          buttonId: buttonId,
          sourcePage: window.location.pathname,
          referrer: document.referrer || "",
          utmSource: params.get("utm_source") || "",
          utmMedium: params.get("utm_medium") || "",
          utmCampaign: params.get("utm_campaign") || "",
          utmContent: params.get("utm_content") || ""
        };

        var url = "/api/whatsapp-click";
        var body = JSON.stringify(payload);

        if (navigator.sendBeacon) {
          var blob = new Blob([body], { type: "application/json" });
          navigator.sendBeacon(url, blob);
        } else if (window.fetch) {
          fetch(url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: body,
            keepalive: true
          }).catch(function () {});
        }
      });
    </script>
  </body>
</html>
