---
import instagramData from "../content/instagram.json";

const data = instagramData || {
  enabled: true,
  eyebrow: "NOSSO DIA A DIA",
  title: "Acompanhe a Gaia no Instagram",
  description: "Siga o perfil oficial da Gaia e acompanhe momentos da rotina, atividades e ambientes da casa.",
  buttonText: "Seguir a Gaia no Instagram",
  profileUrl: "https://www.instagram.com/gaiaresidenciaparaidosos/"
};
---

{data.enabled && (
  <section class="section instagram-cta-section" id="instagram" aria-label="Acompanhe a Gaia no Instagram">
    <div class="container">
      <div class="instagram-cta-card">
        <div class="instagram-cta-text">
          <p class="eyebrow">{data.eyebrow || "NOSSO DIA A DIA"}</p>
          <h2>{data.title || "Acompanhe a Gaia no Instagram"}</h2>
          <p>{data.description || "Siga o perfil oficial da Gaia e acompanhe momentos da rotina, atividades e ambientes da casa."}</p>
        </div>
        <div class="instagram-cta-action">
          <a
            class="button button-instagram-cta"
            href={data.profileUrl || "https://www.instagram.com/gaiaresidenciaparaidosos/"}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Seguir a Gaia no Instagram (abre em nova aba)"
          >
            <span class="instagram-logo-badge" aria-hidden="true">
              <img
                src="/media/site/instagram-logo-oficial.png"
                alt=""
                width="34"
                height="34"
                class="instagram-btn-logo"
              />
            </span>
            <span class="instagram-btn-text">{data.buttonText || "Seguir a Gaia no Instagram"}</span>
          </a>
        </div>
      </div>
    </div>
  </section>
)}

<style>
  .instagram-cta-section {
    background: #fffdf9;
    padding: clamp(3rem, 5vw, 4.5rem) 0;
  }
  .instagram-cta-card {
    background: var(--cream, #f7f3e8);
    border: 1px solid #e5decb;
    border-radius: var(--radius, 1.2rem);
    padding: clamp(2rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.5rem, 4vw, 3rem);
    box-shadow: 0 10px 30px rgba(18, 63, 51, 0.04);
  }
  .instagram-cta-text {
    max-width: 620px;
  }
  .instagram-cta-text h2 {
    margin-bottom: 0.8rem;
    font-size: clamp(1.8rem, 3.2vw, 2.4rem);
    color: var(--ink, #163128);
  }
  .instagram-cta-text p:not(.eyebrow) {
    margin: 0;
    color: var(--muted, #495c56);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .instagram-cta-action {
    flex-shrink: 0;
  }
  .button-instagram-cta {
    min-height: 56px;
    padding: 0.5rem 1.4rem 0.5rem 0.65rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #1c2c24;
    background: var(--yellow, #fdbd16);
    border: 1px solid transparent;
    border-radius: 0.85rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.02rem;
    box-shadow: 0 8px 22px rgba(253, 189, 22, 0.25);
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }
  .button-instagram-cta:hover {
    background: #ffc93d;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(253, 189, 22, 0.35);
  }
  .instagram-logo-badge {
    width: 40px;
    height: 40px;
    background: #ffffff;
    border-radius: 10px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.1);
  }
  .instagram-btn-logo {
    width: 32px;
    height: 32px;
    object-fit: contain;
    display: block;
  }
  .instagram-btn-text {
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .instagram-cta-card {
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      gap: 1.6rem;
      padding: 2.2rem 1.8rem;
    }
    .instagram-cta-action {
      width: 100%;
    }
    .button-instagram-cta {
      width: auto;
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .instagram-cta-section {
      padding: 2.2rem 0;
    }
    .instagram-cta-card {
      padding: 1.6rem 1.2rem;
      gap: 1.4rem;
    }
    .instagram-cta-text h2 {
      font-size: 1.6rem;
    }
    .instagram-cta-text p:not(.eyebrow) {
      font-size: 0.95rem;
    }
    .button-instagram-cta {
      width: 100%;
      min-height: 52px;
      padding: 0.5rem 1rem 0.5rem 0.6rem;
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .button-instagram-cta {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
