---
import instagramData from "../content/instagram.json";

interface InstagramPost {
  id: string;
  type: "image" | "reel" | "carousel";
  image: string;
  alt: string;
  caption: string;
  permalink: string;
  publishedAt?: string;
  authorized: boolean;
  reviewStatus: string;
}

interface InstagramConfig {
  enabled: boolean;
  eyebrow?: string;
  title?: string;
  description?: string;
  profileHandle?: string;
  profileUrl?: string;
  posts?: InstagramPost[];
}

const data = (instagramData || {}) as InstagramConfig;

// Filter posts: must be authorized, approved and contain all mandatory fields
const validPosts = (Array.isArray(data.posts) ? data.posts : [])
  .filter((post): post is InstagramPost => {
    return Boolean(
      post &&
      typeof post.id === "string" && post.id.trim() !== "" &&
      typeof post.image === "string" && post.image.trim() !== "" &&
      typeof post.alt === "string" &&
      typeof post.caption === "string" &&
      typeof post.permalink === "string" && post.permalink.trim() !== "" &&
      post.authorized === true &&
      post.reviewStatus === "approved"
    );
  })
  .sort((a, b) => {
    const timeA = a.publishedAt ? new Date(a.publishedAt).getTime() : 0;
    const timeB = b.publishedAt ? new Date(b.publishedAt).getTime() : 0;
    return timeB - timeA;
  })
  .slice(0, 6);

const shouldRender = Boolean(data.enabled) && validPosts.length > 0;
---

{shouldRender && (
  <section class="section instagram-section" id="instagram" aria-label="Publicações do Instagram da Gaia">
    <div class="container">
      <div class="section-heading instagram-heading">
        <div>
          <p class="eyebrow">{data.eyebrow || "NOSSO DIA A DIA"}</p>
          <h2>{data.title || "Acompanhe a Gaia no Instagram"}</h2>
          {data.description && <p class="instagram-desc">{data.description}</p>}
        </div>
        <div class="instagram-controls" aria-label="Controles do carrossel do Instagram">
          <button type="button" data-insta-prev aria-label="Publicação anterior">←</button>
          <button type="button" data-insta-next aria-label="Próxima publicação">→</button>
        </div>
      </div>

      <div class="instagram-track" data-insta-track tabindex="0" aria-label="Carrossel com publicações do Instagram">
        {validPosts.map((post) => (
          <article class="instagram-card">
            <a
              href={post.permalink}
              target="_blank"
              rel="noopener noreferrer"
              class="instagram-card-link"
              aria-label={`Ver publicação no Instagram: ${post.caption.slice(0, 60)}`}
            >
              <div class="instagram-media">
                <img
                  src={post.image}
                  alt={post.alt}
                  width="400"
                  height="400"
                  loading="lazy"
                  decoding="async"
                />
                {post.type === "reel" && (
                  <span class="type-badge" aria-label="Vídeo Reel">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                )}
                {post.type === "carousel" && (
                  <span class="type-badge" aria-label="Carrossel com várias fotos">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
                      <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z" />
                    </svg>
                  </span>
                )}
              </div>
              <div class="instagram-body">
                <p class="instagram-caption">{post.caption}</p>
                {post.publishedAt && (
                  <time datetime={post.publishedAt} class="instagram-date">
                    {new Date(post.publishedAt).toLocaleDateString("pt-BR", { timeZone: "UTC" })}
                  </time>
                )}
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="instagram-footer">
        <a
          class="button button-instagram-cta"
          href={data.profileUrl || "https://www.instagram.com/gaiaresidenciaparaidosos/"}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="instagram-logo-badge">
            <img
              src="/media/site/instagram-logo-oficial.png"
              alt=""
              aria-hidden="true"
              width="38"
              height="38"
              class="instagram-btn-logo"
            />
          </span>
          <span class="instagram-btn-text">{data.title || "Acompanhe a Gaia no Instagram"}</span>
        </a>
      </div>
    </div>
  </section>
)}

<style>
  .instagram-section {
    background: #fffdf9;
    border-top: 1px solid var(--line, #d9dfd9);
  }
  .instagram-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 2.4rem;
  }
  .instagram-desc {
    margin: 0.8rem 0 0;
    max-width: 540px;
    color: var(--muted, #495c56);
  }
  .instagram-controls {
    display: flex;
    gap: 0.6rem;
    flex-shrink: 0;
  }
  .instagram-controls button {
    width: 48px;
    height: 48px;
    border: 1px solid var(--green-900, #123f33);
    border-radius: 50%;
    color: var(--green-900, #123f33);
    background: transparent;
    cursor: pointer;
    font-size: 1.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .instagram-controls button:hover {
    color: #ffffff;
    background: var(--green-900, #123f33);
  }
  .instagram-track {
    display: flex;
    gap: 1.2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 0.8rem;
  }
  .instagram-track::-webkit-scrollbar {
    display: none;
  }
  .instagram-card {
    flex: 0 0 calc((100% - 2.4rem) / 3);
    min-width: 280px;
    scroll-snap-align: start;
    background: #ffffff;
    border: 1px solid var(--line, #d9dfd9);
    border-radius: var(--radius, 1.2rem);
    overflow: hidden;
    box-shadow: 0 10px 24px rgba(18, 63, 51, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .instagram-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 16px 36px rgba(18, 63, 51, 0.1);
  }
  .instagram-card-link {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    color: inherit;
  }
  .instagram-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: #f0ebe1;
  }
  .instagram-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }
  .instagram-card:hover .instagram-media img {
    transform: scale(1.03);
  }
  .type-badge {
    position: absolute;
    top: 0.8rem;
    right: 0.8rem;
    width: 32px;
    height: 32px;
    background: rgba(18, 63, 51, 0.78);
    color: #ffffff;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    backdrop-filter: blur(4px);
  }
  .instagram-body {
    padding: 1.2rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .instagram-caption {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--ink, #163128);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .instagram-date {
    font-size: 0.8rem;
    color: var(--muted, #495c56);
    font-weight: 600;
  }
  .instagram-footer {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }
  .button-instagram-cta {
    min-height: 64px;
    padding: 0.6rem 1.6rem 0.6rem 0.85rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: #1c2c24;
    background: var(--yellow, #fdbd16);
    border: 1px solid transparent;
    border-radius: 0.9rem;
    text-decoration: none;
    font-weight: 800;
    font-size: 1.05rem;
    box-shadow: 0 8px 22px rgba(253, 189, 22, 0.25);
    transition: transform 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
  }
  .button-instagram-cta:hover {
    background: #ffc93d;
    transform: translateY(-2px);
    box-shadow: 0 12px 28px rgba(253, 189, 22, 0.35);
  }
  .instagram-logo-badge {
    width: 46px;
    height: 46px;
    background: #ffffff;
    border-radius: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .instagram-btn-logo {
    width: 38px;
    height: 38px;
    object-fit: contain;
    display: block;
  }
  .instagram-btn-text {
    white-space: nowrap;
  }

  @media (max-width: 960px) {
    .instagram-card {
      flex: 0 0 calc((100% - 1.2rem) / 2);
    }
  }

  @media (max-width: 640px) {
    .instagram-heading {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }
    .instagram-card {
      flex: 0 0 calc(100% - 1.5rem);
      min-width: 260px;
    }
    .button-instagram-cta {
      min-height: 58px;
      padding: 0.5rem 1.2rem 0.5rem 0.65rem;
      gap: 10px;
      font-size: 0.95rem;
      max-width: 100%;
    }
    .instagram-logo-badge {
      width: 42px;
      height: 42px;
      border-radius: 10px;
    }
    .instagram-btn-logo {
      width: 34px;
      height: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .instagram-card,
    .instagram-media img,
    .instagram-controls button,
    .button-instagram-cta {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-insta-track]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-insta-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-insta-next]");

  if (track && prevBtn && nextBtn) {
    const scrollByAmount = (direction: number) => {
      const card = track.querySelector<HTMLElement>(".instagram-card");
      const gap = 19;
      const amount = (card ? card.offsetWidth : 300) + gap;
      track.scrollBy({ left: direction * amount, behavior: "smooth" });
    };

    prevBtn.addEventListener("click", () => scrollByAmount(-1));
    nextBtn.addEventListener("click", () => scrollByAmount(1));

    track.addEventListener("keydown", (event: KeyboardEvent) => {
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        scrollByAmount(-1);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        scrollByAmount(1);
      }
    });
  }
</script>
