---
import site from "../content/site.json";
---

<section class="section services" id="servicos">
  <div class="container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">{site.servicesHeading.eyebrow}</p>
        <h2>{site.servicesHeading.title}</h2>
      </div>
      <p>{site.servicesHeading.description}</p>
    </div>
    <div class="card-grid service-grid">
      {site.services.map((service, index) => (
        <article class="card service-card">
          <span class="service-number" aria-hidden="true">0{index + 1}</span>
          <h3>{service.title}</h3>
          <p>{service.description}</p>
          <a class="text-link" href={service.href}>Conhecer o serviço <span aria-hidden="true">→</span></a>
        </article>
      ))}
    </div>
    <div class="services-cta-wrapper">
      <a
        class="button button-whatsapp"
        href={`https://wa.me/${site.contact.whatsappDigits}?text=${encodeURIComponent("Olá! Gostaria de conversar com a Gaia sobre as modalidades de cuidado.")}`}
        target="_blank"
        rel="noreferrer"
        data-event="services_whatsapp"
      >
        <img src="/icons/whatsapp-enviado.png" alt="" aria-hidden="true" width="26" height="26" class="button-whatsapp-icon" />
        <span>{site.servicesHeading.cta}</span>
      </a>
    </div>
  </div>
</section>
