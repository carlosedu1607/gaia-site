---
import site from "../content/site.json";
---

<section class="hero">
  <picture class="hero-media">
    <source media="(max-width: 640px)" srcset="/media/site/hero-fachada-2-800.webp" />
    <source media="(max-width: 1080px)" srcset="/media/site/hero-fachada-2-1280.webp" />
    <img
      src="/media/site/hero-fachada-2-1920.webp"
      alt="Fachada da Gaia Vida Ainda, residência para idosos em Curitiba."
      width="1920"
      height="1080"
      fetchpriority="high"
      loading="eager"
      decoding="async"
    />
  </picture>
  <div class="hero-overlay"></div>
  <div class="container hero-content">
    <p class="eyebrow light">{site.hero.eyebrow}</p>
    <h1>{site.hero.title}</h1>
    <p>{site.hero.text}</p>
    <div class="button-group">
      <a class="button button-primary" href="/contato/" data-event="hero_agendar">{site.hero.primaryCta}</a>
      <a
        class="button button-whatsapp"
        href={`https://wa.me/${site.contact.whatsappDigits}?text=${encodeURIComponent("Olá! Gostaria de conhecer melhor a Gaia e agendar uma visita.")}`}
        target="_blank"
        rel="noreferrer"
        data-event="hero_whatsapp"
      >
        <img src="/icons/whatsapp-enviado.png" alt="" aria-hidden="true" width="26" height="26" class="button-whatsapp-icon" />
        <span>{site.hero.secondaryCta}</span>
      </a>
    </div>
  </div>
</section>
