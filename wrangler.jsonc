{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gaia-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "triggers": {
    "crons": ["0 12 * * 5"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gaia-leads",
      "database_id": "f8b5bd49-ef3c-4681-b07a-3456f3846317",
      "migrations_dir": "db/migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://gaiaresidencia.com.br",
    "LEAD_NOTIFICATION_EMAILS": "contato@gaiaresidencia.com.br,sara@gaiaresidencia.com.br,eve@gaiaresidencia.com.br",
    "WEEKLY_REPORT_EMAIL": "sara@gaiaresidencia.com.br",
    "LEAD_EMAIL_FROM": "Gaia Notificações <notificacoes@envios.gaiaresidencia.com.br>"
  },
  "observability": {
    "enabled": false
  }
}
