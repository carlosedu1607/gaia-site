# URL final do site
SITE_URL=https://gaiaresidenciaparaidosos.com.br

# Modo de revisão (true exibe banner de aviso no topo; false para versão final/produção)
PUBLIC_REVIEW_MODE=false

# Chave pública do Cloudflare Turnstile (opcional no frontend)
PUBLIC_TURNSTILE_SITE_KEY=

# Chave secreta do Cloudflare Turnstile (para backend/worker)
# TURNSTILE_SECRET_KEY=

# Destinatários para notificações de novos leads e cliques no WhatsApp (separados por vírgula)
# LEAD_NOTIFICATION_EMAILS=sara@exemplo.com,eve@exemplo.com

# Remetente dos e-mails de notificação
# LEAD_EMAIL_FROM=Gaia Notificações <notificacoes@gaiaresidenciaparaidosos.com.br>

# Chave de API do Resend para disparo de e-mails transacionais
# RESEND_API_KEY=re_123456789

# Webhook alternativo para CRM ou notificações externas (opcional)
# LEAD_NOTIFICATION_WEBHOOK_URL=
# LEAD_NOTIFICATION_WEBHOOK_SECRET=

# Salt para anonimização de IP nos logs/banco
# IP_SALT=gaia-producao-salt
