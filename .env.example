# URL final do site. Trocar quando o domínio curto for definido.
SITE_URL=https://gaiaresidenciaparaidosos.com.br

# Manter true enquanto Sara e Eve estiverem validando o conteúdo.
PUBLIC_REVIEW_MODE=true

# Chave pública do widget Cloudflare Turnstile.
PUBLIC_TURNSTILE_SITE_KEY=

# Segredos ficam em .dev.vars no ambiente local ou via `wrangler secret put`.
# TURNSTILE_SECRET_KEY=
# LEAD_HASH_SALT=
# LEAD_NOTIFICATION_WEBHOOK_URL=
# LEAD_NOTIFICATION_WEBHOOK_SECRET=
